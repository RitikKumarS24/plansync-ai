{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudyPlanSchema",
  "type": "object",
  "properties": {
    "student_name": { "type": "string" },
    "total_days": { "type": "integer" },
    "daily_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": { "type": "integer" },
          "date": { "type": "string" },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": { "type": "string" },
                "subject": { "type": "string" },
                "topic": { "type": "string" },
                "activity_type": { "type": "string", "enum": ["Core Study", "Problem Solving", "Revision", "Mock Test"] }
              },
              "required": ["time", "subject", "topic", "activity_type"]
            }
          }
        },
        "required": ["day", "date", "slots"]
      }
    }
  },
  "required": ["student_name", "total_days", "daily_schedule"]
}